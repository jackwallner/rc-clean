#!/usr/bin/env python3
"""
rc-clean-test-users — remove RevenueCat *test* customers for the current app.

A "test" customer is one we can prove is NOT a real App Store buyer:
  * the app has never been released (any customer must be TestFlight/sim), OR
  * the customer's last-seen app version was never READY_FOR_SALE — including
    TestFlight-only marketing versions (from ASC builds) and versions that are
    submitted but still in review / prepare, OR
  * they only ever had sandbox purchases (no real App Store purchase).
This pairs RevenueCat's per-customer version with Apple's App Store versions
AND TestFlight build inventory, so it stays correct as builds get approved.
It also clears non-purchasers first seen before the earliest public release.
Anyone with a real (non-sandbox) purchase is NEVER touched.

Run it from inside an app's repo (auto-detects the app from its bundle id):
    rc-clean-test-users            # dry run: list what WOULD be deleted
    rc-clean-test-users --delete   # actually delete
    rc-clean-test-users --all-apps # every configured app (dry run unless --delete)

Auth:
  * App Store Connect: ~/.baseball_credentials (ASC_API_KEY_ID/ISSUER_ID/KEY_PATH)
  * RevenueCat: ~/.revenuecat/auth_token (a dashboard token; self-refreshes).
    If it ever expires, log in at app.revenuecat.com and reseed with:
      rc-clean-test-users --reseed <authentication_token>
    (get the token from the dashboard: DevTools > run
     fetch('/v1/developers/login/refresh-token',{method:'POST',
     headers:{'X-Requested-With':'XMLHttpRequest'},credentials:'include'})
     .then(r=>r.json()).then(d=>copy(d.authentication_token)) )
"""
import os, sys, re, json, time, argparse, datetime, subprocess, urllib.parse
import jwt, requests

RC = "https://app.revenuecat.com"
ASC = "https://api.appstoreconnect.apple.com"
ITUNES = "https://itunes.apple.com/lookup"
def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr); sys.exit(code)

def _first_existing(*paths, default=None):
    for p in paths:
        if not p: continue
        p = os.path.expanduser(os.path.expandvars(p))
        if os.path.exists(p): return p
    return os.path.expanduser(os.path.expandvars(default)) if default else None

TOKEN_FILE = os.path.expanduser(os.path.expandvars(
    os.environ.get("RC_CLEAN_TOKEN", "~/.revenuecat/auth_token")))

# App Store Connect API creds (a shell-style file exporting ASC_API_KEY_ID /
# ASC_ISSUER_ID / ASC_KEY_PATH). Override with $RC_CLEAN_ASC_CREDS.
ASC_CREDS = _first_existing(os.environ.get("RC_CLEAN_ASC_CREDS"),
                            "~/.rc-clean/asc_credentials",
                            "~/.baseball_credentials",
                            default="~/.rc-clean/asc_credentials")

# bundle id -> {rc: RevenueCat project id, asc: App Store Connect app id, name}.
# Loaded from JSON so no private app list is baked into the tool. Search order:
# $RC_CLEAN_APPS, ~/.rc-clean/apps.json, apps.json / apps.example.json beside this file.
def load_apps():
    here = os.path.dirname(os.path.abspath(__file__))
    for c in (os.environ.get("RC_CLEAN_APPS"), "~/.rc-clean/apps.json",
              os.path.join(here, "apps.json"), os.path.join(here, "apps.example.json")):
        if not c: continue
        p = os.path.expanduser(os.path.expandvars(c))
        if os.path.exists(p):
            with open(p) as f: data = json.load(f)
            if data: return data
    die('no apps config found. Create ~/.rc-clean/apps.json (see apps.example.json):\n'
        '  { "com.you.app": {"rc": "<rc project id>", "asc": "<asc app id>", "name": "App"} }')

APPS = {}  # populated in main()

# ---------- app detection ----------
def _match_bundle(text):
    """Pick the base-app bundle id from project text (shortest = no .watch/.widget suffix)."""
    hits = [b for b in APPS if b in text]
    hits.sort(key=len)
    return hits[0] if hits else None

def detect_bundle():
    """Find this app's base bundle id by walking UP from the cwd to the nearest
    project.yml / *.xcodeproj. Deliberately does NOT trust `git rev-parse
    --show-toplevel`: the home dir is itself a git repo with every app nested
    inside it, so the git root is useless for telling the apps apart."""
    home = os.path.expanduser("~")
    d = os.getcwd()
    while True:
        # the home dir (and anything above it) is ambiguous: every app is nested
        # under it, so refuse rather than silently guess. Use --all-apps there.
        at_home = os.path.normpath(d) == os.path.normpath(home)
        # nearest project.yml wins — this is the per-app manifest
        for name in ("project.yml", "Project.yml"):
            p = os.path.join(d, name)
            if os.path.exists(p):
                b = _match_bundle(open(p, errors="ignore").read())
                if b: return b
        # fall back to a bounded scan of THIS app's project files (non-XcodeGen repos)
        if not at_home:
            text = ""
            for dirpath, dirs, files in os.walk(d):
                # prune: never descend into .git or into a nested/sibling app repo
                dirs[:] = [x for x in dirs if x != ".git" and not any(
                    os.path.exists(os.path.join(dirpath, x, m))
                    for m in ("project.yml", "Project.yml"))]
                for f in files:
                    if f.endswith((".pbxproj", "Info.plist")):
                        try: text += open(os.path.join(dirpath, f), errors="ignore").read()
                        except Exception: pass
            b = _match_bundle(text)
            if b: return b
        parent = os.path.dirname(d)
        if at_home or parent == d:  # stop at home / filesystem root
            return None
        d = parent

# ---------- App Store Connect ----------
def canon(v):
    if not v: return ""
    parts = [int(x) if x.isdigit() else 0 for x in str(v).split(".")]
    while len(parts) > 1 and parts[-1] == 0: parts.pop()
    return ".".join(map(str, parts))

def asc_token():
    env = {}
    for line in open(ASC_CREDS, errors="ignore"):
        m = re.match(r'\s*export\s+(\w+)="?([^"\n]+)"?', line)
        if m: env[m.group(1)] = m.group(2)
    key = open(os.path.expanduser(os.path.expandvars(env["ASC_KEY_PATH"]))).read()
    now = int(time.time())
    return jwt.encode({"iss": env["ASC_ISSUER_ID"], "iat": now, "exp": now + 1200,
                       "aud": "appstoreconnect-v1"}, key, algorithm="ES256",
                      headers={"kid": env["ASC_API_KEY_ID"], "typ": "JWT"})

def _asc_get(path, headers, params=None):
    r = requests.get(f"{ASC}{path}", headers=headers, params=params or {})
    r.raise_for_status()
    return r.json()

def itunes_release_date(asc_app_id):
    """Return Apple's public first-release date when the app is listed."""
    try:
        r = requests.get(ITUNES, params={"id": asc_app_id, "country": "us"},
                         timeout=20)
        r.raise_for_status()
        row = (r.json().get("results") or [{}])[0]
        return row.get("releaseDate") or None
    except (requests.exceptions.RequestException, ValueError, IndexError):
        return None

def asc_inventory(asc_app_id):
    """Cross App Store submissions with TestFlight builds.

    Returns dict:
      released:  canon versions currently READY_FOR_SALE
      pending:   canon versions with a store submission that is NOT live
                 (WAITING_FOR_REVIEW, PREPARE_FOR_SUBMISSION, …)
      tf_only:   canon TF marketing versions that were never READY_FOR_SALE
      store:     list of {version, state, build} for logging
      tf:        list of {version, builds:[...], max_build} for logging
      public_release_date: Apple's public first-release date, when listed
      earliest_release_date: earliest ASC releaseDate for a live version
      earliest_live_upload: fallback release boundary from live build upload
    """
    h = {"Authorization": f"Bearer {asc_token()}"}

    # --- App Store versions + the build attached to each submission ---
    j = _asc_get(f"/v1/apps/{asc_app_id}/appStoreVersions", h,
                 {"limit": 50, "include": "build"})
    by_id = {b["id"]: b["attributes"] for b in j.get("included", [])
             if b["type"] == "builds"}
    store, released, pending = [], set(), set()
    live_release_dates, live_uploaded_dates = [], []
    for v in j.get("data", []):
        a = v["attributes"]
        ver, state = a.get("versionString") or "", a.get("appStoreState") or ""
        rel = ((v.get("relationships") or {}).get("build") or {}).get("data") or {}
        battrs = by_id.get(rel.get("id"), {}) if rel else {}
        build_num = battrs.get("version")
        if rel and build_num is None:
            try:
                bj = _asc_get(f"/v1/builds/{rel['id']}", h)
                battrs = bj["data"]["attributes"]
                build_num = battrs.get("version")
            except Exception:
                pass
        c = canon(ver)
        release_date = a.get("releaseDate")
        store.append({"version": ver, "canon": c, "state": state,
                      "build": build_num, "release_date": release_date})
        if state == "READY_FOR_SALE":
            released.add(c)
            if release_date:
                live_release_dates.append(release_date)
            up = battrs.get("uploadedDate")
            if up:
                live_uploaded_dates.append(up)
        elif c:
            pending.add(c)

    # --- TestFlight builds → marketing versions (paginate) ---
    tf_builds = {}  # canon -> sorted unique build numbers
    tf_raw = {}     # canon -> example raw version string
    params = {"filter[app]": asc_app_id, "limit": 50, "sort": "-uploadedDate",
              "include": "preReleaseVersion"}
    for _ in range(20):
        j = _asc_get("/v1/builds", h, params)
        pr = {x["id"]: x["attributes"].get("version")
              for x in j.get("included", []) if x["type"] == "preReleaseVersions"}
        for b in j.get("data", []):
            a = b["attributes"]
            prid = (((b.get("relationships") or {}).get("preReleaseVersion") or {})
                    .get("data") or {})
            raw = pr.get(prid.get("id"))
            if not raw:
                continue
            c = canon(raw)
            tf_raw.setdefault(c, raw)
            try:
                num = int(a.get("version"))
            except (TypeError, ValueError):
                continue
            tf_builds.setdefault(c, set()).add(num)
        nxt = (j.get("links") or {}).get("next")
        if not nxt:
            break
        cursor = urllib.parse.parse_qs(
            urllib.parse.urlparse(nxt).query).get("cursor", [None])[0]
        if not cursor:
            break
        params = {"cursor": cursor}

    tf, tf_only = [], set()
    for c, nums in sorted(tf_builds.items(), key=lambda kv: kv[0]):
        tf.append({"version": tf_raw.get(c, c), "canon": c,
                   "builds": sorted(nums), "max_build": max(nums) if nums else None})
        if c and c not in released:
            tf_only.add(c)

    earliest_release_date = min(live_release_dates) if live_release_dates else None
    earliest_live_upload = min(live_uploaded_dates) if live_uploaded_dates else None
    public_release_date = itunes_release_date(asc_app_id)
    return {"released": released, "pending": pending, "tf_only": tf_only,
            "store": store, "tf": tf,
            "public_release_date": public_release_date,
            "earliest_release_date": earliest_release_date,
            "earliest_live_upload": earliest_live_upload}

# ---------- RevenueCat (dashboard token, self-refreshing) ----------
class RC_API:
    def __init__(self):
        if not os.path.exists(TOKEN_FILE):
            die(f"no RevenueCat token at {TOKEN_FILE}; reseed with --reseed <token>")
        self.token = open(TOKEN_FILE).read().strip()
        self._refresh()

    def _refresh(self):
        r = requests.post(f"{RC}/v1/developers/login/refresh-token",
                          headers=self._h(), json={})
        if r.status_code != 200:
            die("RevenueCat token expired/invalid; reseed with --reseed <token> "
                "(see header comment for how to get one)")
        self.token = r.json()["authentication_token"]
        with open(TOKEN_FILE, "w") as f: f.write(self.token)
        os.chmod(TOKEN_FILE, 0o600)

    def _h(self):
        return {"X-Requested-With": "XMLHttpRequest", "Authorization": f"Bearer {self.token}"}

    def get(self, path, **kw):
        return self._req("get", path, **kw)

    def post(self, path, **kw):
        return self._req("post", path, **kw)

    def delete(self, path):
        return self._req("delete", path)

    def _req(self, method, path, retries=4, **kw):
        last = None
        for attempt in range(retries):
            try:
                r = getattr(requests, method)(f"{RC}{path}", headers=self._h(), **kw)
                if r.status_code in (429, 502, 503, 504) and attempt + 1 < retries:
                    time.sleep(1.5 * (attempt + 1))
                    continue
                return r
            except (requests.exceptions.ConnectionError,
                    requests.exceptions.Timeout) as e:
                last = e
                time.sleep(1.5 * (attempt + 1))
        raise last

    # Enumerate every customer first-seen in [start,end) through the current
    # Audience preview endpoint. Preview returns at most 100 sample rows, so
    # split date ranges until each response is complete.
    def enumerate_customers(self, pid, start, end, depth=0):
        rules = {"groups": [{"conditions": [
            {"field": "firstSeenAt", "operator": "afterOrOn", "value": start},
            {"field": "firstSeenAt", "operator": "before", "value": end},
        ]}]}
        r = self.post(
            f"/internal/v1/developers/me/projects/{pid}/audiences/actions/preview",
            params={"limit": 100}, json={"rules": rules})
        if r.status_code != 200:
            raise RuntimeError(
                f"RevenueCat Audience preview failed for {pid}: "
                f"HTTP {r.status_code} {r.text[:500]}")
        try:
            j = r.json()
        except ValueError as e:
            raise RuntimeError(
                f"RevenueCat Audience preview returned invalid JSON for {pid}") from e
        rows = j.get("customer_sample") or []
        total = (j.get("stats") or {}).get("total_customers")
        if not isinstance(total, int):
            raise RuntimeError(
                f"RevenueCat Audience preview omitted total_customers for {pid}")
        if total > 100:
            ds = datetime.date.fromisoformat(start)
            de = datetime.date.fromisoformat(end)
            span = (de - ds).days
            if depth >= 8 or span <= 1:
                raise RuntimeError(
                    f"RevenueCat Audience preview has {total} customers in a "
                    f"single date bucket for {pid}; refusing to truncate results")
            mid = ds + datetime.timedelta(days=span // 2)
            left = self.enumerate_customers(pid, start, mid.isoformat(), depth + 1)
            right = self.enumerate_customers(pid, mid.isoformat(), end, depth + 1)
            return list(dict.fromkeys(left + right))
        return list(dict.fromkeys(
            row["app_user_id"] for row in rows if row.get("app_user_id")))

    def customer(self, pid, app_user_id):
        r = self.get(f"/v1/developers/me/projects/{pid}/subscribers/"
                     f"{urllib.parse.quote(app_user_id, safe='')}?sandbox_mode=false")
        if r.status_code == 404:
            return None
        r.raise_for_status()
        subscriber = r.json().get("subscriber")
        if not isinstance(subscriber, dict):
            raise RuntimeError(
                f"RevenueCat subscriber detail was missing for {pid}/{app_user_id}")
        return subscriber

    def delete_customer(self, pid, app_user_id):
        r = self.delete(f"/v1/developers/me/projects/{pid}/subscribers/"
                        f"{urllib.parse.quote(app_user_id, safe='')}")
        return r.status_code in (200, 202, 204)

# ---------- core ----------
def _has_real_purchase(s):
    return any(h.get("product") and h.get("is_sandbox") is False
               for h in s.get("history", []))

def _is_sandbox_only(s):
    """True if we can prove sandbox activity and no real purchase."""
    if _has_real_purchase(s):
        return False
    if any(h.get("product") and h.get("is_sandbox") is True
           for h in s.get("history", [])):
        return True
    status = s.get("subscription_status") or {}
    if status.get("sandbox") and not status.get("live"):
        return True
    return False

def _log(msg=""):
    print(msg, flush=True)

def clean_app(rc, bundle, do_delete, since_days=None, created_before=None):
    app = APPS[bundle]
    pid, name = app["rc"], app["name"]
    inv = asc_inventory(app["asc"])
    released, pending, tf_only = inv["released"], inv["pending"], inv["tf_only"]
    never_public = len(released) == 0
    public_release = inv.get("public_release_date")
    earliest_release = inv.get("earliest_release_date")
    earliest_live_upload = inv.get("earliest_live_upload")
    release_boundary = public_release or earliest_release or earliest_live_upload
    release_boundary_date = release_boundary[:10] if release_boundary else None
    # anything not READY_FOR_SALE is test — pending submissions + TF-only builds
    test_versions = pending | tf_only

    end = datetime.date.today() + datetime.timedelta(days=1)
    if since_days is None:
        start = datetime.date(2026, 1, 1)
    else:
        start = datetime.date.today() - datetime.timedelta(days=since_days)

    _log(f"\n=== {name}  (RC {pid})  bundle {bundle} ===")
    _log(f"window: {start.isoformat()} → {end.isoformat()}  "
         f"({'last '+str(since_days)+'d' if since_days is not None else 'YTD'})")
    _log(f"released (READY_FOR_SALE): {sorted(released) if released else 'NONE — app not public'}")
    if public_release:
        _log(f"first public release:    {public_release[:19]}")
    elif earliest_release:
        _log(f"ASC release date:        {earliest_release[:19]}")
    elif earliest_live_upload:
        _log(f"release boundary fallback: {earliest_live_upload[:19]}")
    if pending:
        _log(f"submitted not live:     {sorted(pending)}")
    if tf_only:
        _log(f"TF-only versions:       {sorted(tf_only)}")
    # compact TF vs submitted line for the versions that matter
    store_by_canon = {s["canon"]: s for s in inv["store"]}
    for t in inv["tf"]:
        s = store_by_canon.get(t["canon"])
        state = s["state"] if s else "NO_STORE_VERSION"
        sbuild = s.get("build") if s else None
        flag = ""
        if t["canon"] not in released:
            flag = " → TEST"
        _log(f"  TF {t['version']:8} builds={t['builds'][-4:]} max=#{t['max_build']}  "
             f"store={state} build=#{sbuild}{flag}")

    ids = rc.enumerate_customers(pid, start.isoformat(), end.isoformat())
    _log(f"scanning {len(ids)} customers...")

    test, stale_ghosts, kept_purchasers, real = [], set(), 0, 0
    for i, uid in enumerate(ids):
        s = rc.customer(pid, uid)
        if not s:
            # The Audience preview is live, but a deleted customer can remain
            # in its sample briefly. A 404 is stale index data, not a delete
            # candidate.
            stale_ghosts.add(uid)
            continue
        if _has_real_purchase(s):
            kept_purchasers += 1; continue
        ver = s.get("last_seen_app_version")
        c = canon(ver)
        reason = None
        created_str = (s.get("created_at") or "")[:10]
        if never_public:
            reason = "pre-release"
        elif release_boundary_date and created_str and created_str < release_boundary_date:
            reason = "pre-release"
        elif created_before and created_str and created_str < created_before:
            reason = "pre-approval"
        elif c in test_versions or c not in released:
            reason = "tf/pending" if c in test_versions else "unknown-ver"
        elif _is_sandbox_only(s):
            reason = "sandbox"
        if reason:
            test.append((uid, ver or "(none)", created_str, reason))
        else:
            real += 1
        if (i + 1) % 25 == 0:
            _log(f"  … {i+1}/{len(ids)} scanned, {len(test)} test so far")
        time.sleep(0.03)

    if stale_ghosts:
        _log(f"  stale/absent rows skipped: {len(stale_ghosts)}")
    _log(f"  real (kept): {real}   purchasers (kept): {kept_purchasers}   TEST: {len(test)}")
    from collections import Counter
    byver = Counter(v for _, v, _, _ in test)
    byreason = Counter(r for _, _, _, r in test)
    if byver:
        _log("  test by version: " + ", ".join(f"{v}×{n}" for v, n in byver.most_common()))
    if byreason:
        _log("  test by reason:  " + ", ".join(f"{r}×{n}" for r, n in byreason.most_common()))
    for uid, ver, first, reason in test[:200]:
        _log(f"    {'DELETE' if do_delete else 'would delete'}  {uid[:44]:44}  "
             f"v{ver:10} first={first}  ({reason})")

    if do_delete and test:
        ok = 0
        for uid, _, _, _ in test:
            if rc.delete_customer(pid, uid): ok += 1
            time.sleep(0.08)
        _log(f"  deleted {ok}/{len(test)}")
    elif test:
        _log(f"  (dry run — pass --delete to remove these {len(test)})")
    return len(test)

def main():
    ap = argparse.ArgumentParser(description="Delete RevenueCat test customers for the current app.")
    ap.add_argument("--delete", action="store_true", help="actually delete (default: dry run)")
    ap.add_argument("--all-apps", action="store_true", help="run for every configured app")
    ap.add_argument("--since-days", type=int, default=None, metavar="N",
                    help="only customers first-seen in the last N days (default: since 2026-01-01)")
    ap.add_argument("--created-before", metavar="YYYY-MM-DD", default=None,
                    help="flag non-purchaser customers created before YYYY-MM-DD as test (e.g. pre-approval TF users)")
    ap.add_argument("--jobs", type=int, default=1, metavar="N",
                    help="parallel apps when using --all-apps (default: 1)")
    ap.add_argument("--reseed", metavar="TOKEN", help="store a fresh RevenueCat dashboard token and exit")
    args = ap.parse_args()

    if args.reseed:
        os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
        with open(TOKEN_FILE, "w") as f: f.write(args.reseed.strip())
        os.chmod(TOKEN_FILE, 0o600)
        print(f"stored token to {TOKEN_FILE}"); return

    global APPS
    APPS = load_apps()

    # one shared RC session; each worker uses it (token refresh is serialized enough)
    rc = RC_API()
    if args.all_apps:
        bundles = list(APPS)
        jobs = max(1, args.jobs)
        _log(f"cleaning {len(bundles)} apps  since_days={args.since_days}  created_before={args.created_before}  jobs={jobs}  "
             f"delete={args.delete}")
        total = 0
        if jobs == 1:
            for bundle in bundles:
                total += clean_app(rc, bundle, args.delete, args.since_days, args.created_before)
        else:
            from concurrent.futures import ThreadPoolExecutor, as_completed
            # each thread gets its own RC_API so token refresh / requests don't race
            def _run(bundle):
                return clean_app(RC_API(), bundle, args.delete, args.since_days, args.created_before)
            with ThreadPoolExecutor(max_workers=jobs) as ex:
                futs = {ex.submit(_run, b): b for b in bundles}
                for fut in as_completed(futs):
                    b = futs[fut]
                    try:
                        total += fut.result()
                    except Exception as e:
                        _log(f"ERROR {APPS[b]['name']}: {e}")
        _log(f"\nTOTAL test customers {'deleted' if args.delete else 'found'}: {total}")
        return

    bundle = detect_bundle()
    if not bundle:
        die("couldn't detect the app from this folder. cd into an app repo, or use --all-apps.\n"
            "known bundles: " + ", ".join(APPS))
    clean_app(rc, bundle, args.delete, args.since_days, args.created_before)

if __name__ == "__main__":
    main()
